@startuml
' Diagrama de clases: entidades TypeORM (apps/LP-API/src/db/entities) y
' dominio de la trivia guardado en Redis (modules/game/match/domain).
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 30

package "Entidades (TypeORM, PostgreSQL)" {
  abstract class CoreEntity {
    +id: uuid
    +active: boolean
    +createdAt: Date
    +updatedAt: Date
  }

  class User {
    +username: string
    +email: string
    +score: number
    +gamesPlayed: number
    +gamesWon: number
    +currentStreak: number
    +userRole: UserRoles
    +level: Level
    +avatarId: uuid?
  }

  class MediaAsset {
    +key: string
    +bucketName: string
    +contentType: ContentType
    +mimeType: string?
    +displayName: string?
    +size: number?
    +url: string?
    +status: MediaStatus
    +uploadedByUserId: uuid?
  }

  class CategoryQuestion {
    +level: Level
    +descriptionCategory: string
    +type: TypeQuestionCategory
  }

  class Question {
    +contentType: ContentType
    +text: string
    +moreInfo: string?
    +categoryId: uuid
    +timeLimit: number
    +mediaId: uuid?
  }

  class QuestionOption {
    +contentType: ContentType
    +text: string?
    +isCorrect: boolean
    +questionId: uuid
    +mediaId: uuid?
  }

  class Game {
    +difficulty: Level
  }

  class GameSession {
    +userId: uuid
    +gameId: uuid
    +score: number
    +position: number?
  }

  class PlayerAnswer {
    +gameSessionId: uuid
    +questionId: uuid
    +selectedOptionId: uuid
    +isCorrect: boolean
    +timeTaken: number
  }

  class Story {
    +gameId: string {unique}
    +title: string?
    +level: Level
    +language: string
    +panelsCount: number
    +characters: jsonb
    +finishedAt: Date
    +visibility: StoryVisibility
    +removedAt: Date?
    +removedById: uuid?
    +removalReason: StoryRemovalReason?
    +removalNote: string?
  }

  class StoryPanel {
    +storyId: uuid
    +order: number
    +authorId: uuid?
    +authorName: string
    +originalText: string
    +finalText: string
    +scene: string
    +characterIds: jsonb
    +corrections: jsonb
    +score: jsonb
    +reactions: jsonb
    +mediaStatus: string
    +audioKey: string?
    +imageKey: string?
    +speechMarks: jsonb?
  }

  class StoryParticipant {
    +storyId: uuid
    +userId: uuid
    +username: string
    +position: number
    +panelsWritten: number
    +totalScore: number
    +averageScore: number
    +left: boolean
  }

  class StoryLike {
    +storyId: uuid
    +userId: uuid
  }

  class StoryModerationLog {
    +storyId: uuid
    +action: StoryModerationAction
    +adminId: uuid?
    +reason: StoryRemovalReason?
    +note: string?
  }
}

package "Enumeraciones" {
  enum UserRoles {
    PLAYER
    ADMIN
  }
  enum Level {
    A1
    A2
    B1
    B2
    C1
    C2
  }
  enum ContentType {
    TEXT
    IMAGE
    AUDIO
    VIDEO
  }
  enum TypeQuestionCategory {
    LISTENING
    GRAMMAR
    READING
    VOCABULARY
    WRITING
    SPEAKING
  }
  enum MediaStatus {
    PENDING
    CONFIRMED
  }
  enum StoryVisibility {
    PUBLISHED
    REMOVED
  }
  enum StoryModerationAction {
    REMOVED
    RESTORED
  }
  enum StoryRemovalReason {
    INAPPROPRIATE_CONTENT
    OFFENSIVE_LANGUAGE
    PERSONAL_DATA
    SPAM
    OTHER
  }
}

package "Dominio de la trivia (Redis)" {
  class Match {
    -roomId: string
    -status: MatchStatus
    -mode: ModeMatch
    -difficulty: Level
    -players: Map<string, PlayerInfo>
    +addPlayer(...)
    +start()
    +addScore(userId, points)
    +getResults(): PlayerInfo[]
    +toPersistence()
    {static} +fromPersistence(data): Match
  }
  class PlayerInfo {
    +userId: string
    +username: string
    +matchScore: number
    +totalScore: number
    +isConnected: boolean
    +isOwner: boolean
  }
  enum MatchStatus {
    WAITING
    STARTING
    PREPARING
    QUESTION_ACTIVE
    PROCESSING
    BETWEEN_QUESTIONS
    FINISHED
  }
  enum ModeMatch {
    SINGLEPLAYER
    MULTIPLAYER
  }
}

CoreEntity <|-- User
CoreEntity <|-- MediaAsset
CoreEntity <|-- CategoryQuestion
CoreEntity <|-- Question
CoreEntity <|-- QuestionOption
CoreEntity <|-- Game
CoreEntity <|-- GameSession
CoreEntity <|-- PlayerAnswer
CoreEntity <|-- Story
CoreEntity <|-- StoryPanel
CoreEntity <|-- StoryParticipant
CoreEntity <|-- StoryLike
CoreEntity <|-- StoryModerationLog

User "0..*" --> "0..1" MediaAsset : avatar
MediaAsset "0..*" --> "0..1" User : uploadedBy
CategoryQuestion "1" -- "0..*" Question : questions
Question "1" *-- "0..*" QuestionOption : options
Question "0..*" --> "0..1" MediaAsset : media
QuestionOption "0..*" --> "0..1" MediaAsset : media
Game "*" -- "*" Question : questions
User "1" -- "0..*" GameSession : gameSessions
Game "1" -- "0..*" GameSession : sessions
GameSession "1" *-- "0..*" PlayerAnswer : answers
PlayerAnswer "0..*" --> "1" Question
PlayerAnswer "0..*" --> "1" QuestionOption : selectedOption

Story "1" *-- "0..*" StoryPanel : panels
Story "1" *-- "0..*" StoryParticipant : participants
Story "1" *-- "0..*" StoryLike
Story "1" *-- "0..*" StoryModerationLog
Story "0..*" --> "0..1" User : removedBy
StoryPanel "0..*" --> "0..1" User : author
StoryParticipant "0..*" --> "1" User
StoryLike "0..*" --> "1" User
StoryModerationLog "0..*" --> "0..1" User : admin

Match "1" o-- "*" PlayerInfo : players
Match --> MatchStatus
Match --> ModeMatch

@enduml
