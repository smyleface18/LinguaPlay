@startuml
' Partida de trivia. Fuente: modules/game (GameGateway, GameService,
' MatchService, GameQueueService/Processor, MatchResultsService).
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 14

actor "Jugador" as Player
participant "LP-MOB" as Mobile
participant "GameGateway\n(/game)" as Gateway
participant "GameService" as GameService
participant "MatchService" as MatchService
participant "QuestionService" as QuestionService
database "Redis\n(MatchStore)" as Store
queue "BullMQ\ngame-question-timeout" as Queue
database "PostgreSQL" as DB

== Crear o unirse a una sala ==
Player -> Mobile: Elegir nivel y modo
Mobile -> Gateway: createGame(level, mode)
Gateway -> MatchService: createMatch(level, mode, owner)
MatchService -> QuestionService: getRandomQuestions(level)
MatchService -> Store: create(match) + sala del usuario
Gateway --> Mobile: ack { roomId, level, modeMatch } + playersUpdated
... o ...
Player -> Mobile: Código de la sala
Mobile -> Gateway: joinGame(roomId)
Gateway -> MatchService: joinMatch (con lock de la sala)
Gateway --> Mobile: ack { roomId } + playersUpdated (a la sala)

== Inicio ==
Player -> Mobile: Empezar
Mobile -> Gateway: startGame()
Gateway -> GameService: start(roomId, userId)
GameService -> MatchService: startMatch
GameService -> Queue: publish-question (dueAt)
Gateway --> Mobile: gameStarted(firstQuestionAt)

== Ciclo de preguntas ==
loop mientras queden preguntas
  Queue -> GameService: publishQuestion(roomId, seq)
  GameService -> MatchService: publishNextQuestion
  GameService -> Queue: close-question (endsAt + gracia)
  Gateway --> Mobile: newQuestion(pregunta, startsAt, endsAt)
  Player -> Mobile: Elegir opción
  Mobile -> Gateway: answer(questionId, answerId)
  Gateway -> MatchService: processAnswer (hora de llegada)
  Gateway --> Mobile: answerResult (al jugador)
  Gateway --> Mobile: playersUpdated (a la sala)
  alt todos respondieron
    Gateway -> GameService: closeQuestionIfAllAnswered
  else vence el tiempo
    Queue -> GameService: closeQuestion(roomId, seq)
  end
  Gateway --> Mobile: questionEnded(nextQuestionAt)
end

== Fin ==
GameService -> MatchService: finishMatch
MatchService -> DB: persist (game, game_session,\nplayer_answer, métricas del user)
Gateway --> Mobile: gameEnded(results)
opt revancha
  Mobile -> Gateway: requestRematch()
  Gateway --> Mobile: rematchStatus / rematchReady
end

@enduml
