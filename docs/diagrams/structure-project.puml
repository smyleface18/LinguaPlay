@startuml

skinparam componentStyle rectangle
skinparam packageStyle rectangle

title LinguaPlay - Estructura del proyecto

' =========================================================
' Repositorio raíz (submódulos)
' =========================================================

package "LinguaPlay (repositorio raíz)" {
    [docs/\n(documentación y diagramas)] as Docs
    [deploy/\n(docker-compose.prod.yml)] as Deploy
    [linguaplay-core/\n(tipos y contratos compartidos)] as Core
}

' =========================================================
' LP-MOB
' =========================================================

package "apps/LP-MOB (Expo / React Native)" {
    package "src/app" {
        [navigation\n(MainTabs, MainTabs.web, stacks)] as MobNav
        [providers\n(tema, sesión)] as MobProviders
    }
    package "src/features" {
        [auth] as MobAuth
        [game] as MobGame
        [story\n(+ story/admin)] as MobStory
        [category] as MobCategory
        [question] as MobQuestion
        [stats] as MobStats
    }
    package "src/shared" {
        [api\n(cliente HTTP, endpoints)] as MobApi
        [components / ui\n(componentes y tema)] as MobUi
        [adapters / types / screens] as MobSharedMisc
    }
    [store\n(Zustand: auth, ui)] as MobStore
}

' =========================================================
' LP-API
' =========================================================

package "apps/LP-API (NestJS)" {
    package "src/common" {
        [envs, guards, ws-auth] as ApiCommonSec
        [redis, cache, storage (S3)] as ApiCommonInfra
        [api (respuestas y filtros)] as ApiCommonApi
    }
    package "src/db" {
        [entities] as ApiEntities
        [migrations] as ApiMigrations
        [enum] as ApiEnums
    }
    package "src/modules" {
        [auth] as ApiAuth
        [category-question / question /\nquestion-options] as ApiContent
        [media] as ApiMedia
        [game (+ match, queue)] as ApiGame
        [story-game (+ queue)] as ApiStoryGame
        [language-review] as ApiReview
        [story-media] as ApiStoryMedia
        [story-history] as ApiStoryHistory
        [stats] as ApiStats
    }
    [test/\n(pruebas e2e y scripts manuales)] as ApiTest
}

MobNav --> MobAuth
MobNav --> MobGame
MobNav --> MobStory
MobNav --> MobCategory
MobNav --> MobQuestion
MobNav --> MobStats
MobAuth --> MobApi
MobStory --> MobApi
MobCategory --> MobApi
MobQuestion --> MobApi
MobStats --> MobApi
MobAuth --> MobStore
MobGame --> MobUi
MobStory --> MobUi

MobApi ..> ApiAuth : HTTP
MobApi ..> ApiContent : HTTP
MobApi ..> ApiStoryHistory : HTTP
MobApi ..> ApiStats : HTTP
MobGame ..> ApiGame : Socket.IO /game
MobStory ..> ApiStoryGame : Socket.IO /story

ApiGame --> ApiEntities
ApiStoryGame --> ApiReview
ApiStoryGame --> ApiStoryMedia
ApiStoryHistory --> ApiEntities
ApiStats --> ApiEntities
ApiContent --> ApiEntities
ApiAuth --> ApiCommonSec
ApiEntities --> ApiMigrations

note right of Core
  Paquete @linguaplay/core: tipos y
  contratos compartidos. Hoy no lo
  importan LP-API ni LP-MOB.
end note
Deploy ..> ApiAuth : imagen api
Deploy ..> MobNav : imagen web

@enduml
