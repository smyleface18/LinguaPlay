# Variables del despliegue (deploy/docker-compose.prod.yml).
# Copiar a deploy/.env.prod y completar. deploy/.env.prod NO se versiona.
# DB_HOST, REDIS_HOST y sus puertos los fija el compose (nombres de servicio).

# ---------- Puertos publicados en el servidor ----------
API_PORT=3000
WEB_PORT=8080

# ---------- Versión web ----------
# URL pública de la API que usa el bundle web (se fija al construir la imagen).
EXPO_PUBLIC_API_BASE_URL=https://api.ejemplo.com

# ---------- PostgreSQL ----------
POSTGRES_USER=linguaplay
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=linguaplay

# ---------- API ----------
MATCH_TTL=3600
# Orígenes permitidos (la URL pública de la versión web), separados por coma.
CORS_ORIGINS=https://app.ejemplo.com

# ---------- AWS (obligatorias: la API no arranca sin ellas) ----------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_S3_BUCKET_NAME=

# ---------- IA (opcionales) ----------
# Sin BEDROCK_REVIEW_MODEL_ID los borradores de la historieta se aceptan sin revisión.
BEDROCK_REGION=
BEDROCK_REVIEW_MODEL_ID=
POLLY_VOICE_ID=
POLLY_REGION=
# none = historietas sin imágenes; cloudflare exige CF_ACCOUNT_ID y CF_API_TOKEN.
IMAGE_PROVIDER=none
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=
IMAGE_TIMEOUT_MS=
